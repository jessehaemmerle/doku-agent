# Kopieren nach .env und ausfüllen. .env ist in .gitignore und wird nie eingecheckt.

# Wiki.js: Administration > API-Zugriff > neuen Schlüssel anlegen (Gruppe mit read:pages, read:source, write:pages)
WIKI_API_KEY=

# Netbox: eigener Benutzer "doku-agent", Token mit Schreibrechten auf DCIM/IPAM/Virtualization
NETBOX_TOKEN=

# Wazuh-API-Benutzer (nur lesend, z.B. Rolle "readonly")
WAZUH_USER=
WAZUH_PASSWORD=

# Intune / Microsoft Graph: App-Registrierung mit Anwendungsberechtigungen *.Read.All
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Passwort für die Web-Oberfläche (Benutzer siehe config.yaml, Standard "admin")
WEB_PASSWORD=

# Modell für "docker compose --profile setup run --rm ollama-pull" (muss zu llm.model passen)
LLM_MODEL=qwen3:8b
