# Kopieren nach .env und ausfüllen. .env ist in .gitignore und wird nie eingecheckt.

# Wiki.js: Administration > API-Zugriff > neuen Schlüssel anlegen (Gruppe mit read:pages, read:source, write:pages)
WIKI_API_KEY=

# Netbox: eigener Benutzer "doku-agent", Token mit Schreibrechten auf DCIM/IPAM/Virtualization
NETBOX_TOKEN=

# Wazuh-API-Benutzer (nur lesend, z.B. Rolle "readonly")
WAZUH_USER=
WAZUH_PASSWORD=

# Intune / Microsoft Graph: App-Registrierung mit Anwendungsberechtigungen *.Read.All
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# Active Directory: Lesekonto (UPN) – ein normaler Domänenbenutzer genügt, keine Admin-Rechte
AD_USER=
AD_PASSWORD=

# Passwort für die Web-Oberfläche (Benutzer siehe config.yaml, Standard "admin")
WEB_PASSWORD=

# FortiGate: REST-API-Admin mit Admin-Profil "nur lesen" (System > Administratoren > REST-API-Admin)
FORTIGATE_TOKEN=

# vCenter: Benutzer mit Rolle "Nur lesen"
VCENTER_USER=
VCENTER_PASSWORD=

# SNMP-Community (v2c) der Switches – nur lesend
SNMP_COMMUNITY=

# Modelle für "docker compose --profile setup run --rm ollama-pull" (müssen zu llm.model bzw. embeddings.model passen)
LLM_MODEL=qwen3:8b
EMBED_MODEL=qwen3-embedding:0.6b
